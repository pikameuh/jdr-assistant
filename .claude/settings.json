{
  "permissions": {
    "allow": [
      "Bash(uv sync)",
      "Bash(uv --version)",
      "Bash(uv run pytest:*)",
      "Bash(uv run python -m agent_jdr.core.rules_index build)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git remote -v)",
      "Bash(git remote get-url:*)",
      "Bash(git config --local --get:*)"
    ],
    "deny": [
      "Read(./secrets.yaml)",
      "Edit(./secrets.yaml)",
      "Read(./.env)"
    ]
  }
}
